    "test_unicode_normalize": {
      "kind": "executable",
      "sources": {
        "files": [
          "test_unicode_normalize.c"
        ]
      },
      "private": {
        "deps": [
          "saltscore_unicode",
          "tinytest"
        ],
        "defines": {
          "SALTS_NFC_TEST_DATA": "\"${envPath:SALTS_UNICODE_DATA_DIR}/NormalizationTest.txt\""
        }
      },
      "test": {
        "name": "saltscore.native.test_unicode_normalize",
        "timeout": 300
      },
      "preTasks": [
        {
          "name": "verify_fixture",
          "program": "cmake",
          "args": [
            "-DSALTS_UNICODE_DATA_DIR=${envPath:SALTS_UNICODE_DATA_DIR}",
            "-DSALTS_UNICODE_VERIFY_FIXTURE=NormalizationTest.txt",
            "-DSALTS_UNICODE_VERIFY_STAMP=$builddir/gen/unicode/test/NormalizationTest.txt.verified",
            "-P",
            "$moduledir/../data/Download.cmake"
          ],
          "inputs": [
            "${envPath:SALTS_UNICODE_DATA_DIR}/NormalizationTest.txt",
            "../data/Download.cmake",
            "../data/sources.lock.json"
          ],
          "outputs": [
            "$builddir/gen/unicode/test/NormalizationTest.txt.verified"
          ]
        }
      ]
    },
