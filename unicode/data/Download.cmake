if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  cmake_minimum_required(VERSION 3.25)
endif()

# Keep official data outside the source distribution. Each file is published
# atomically after verification; concurrent configure/generator jobs share it.
function(download_unicode_file name)
  if(NOT SALTS_UNICODE_DATA_DIR)
    message(FATAL_ERROR "Set SALTS_UNICODE_DATA_DIR to the Unicode 17.0.0 cache directory")
  endif()
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/sources.lock.json" manifest)
  string(JSON url GET "${manifest}" files "${name}" url)
  string(JSON sha256 GET "${manifest}" files "${name}" sha256)
  file(MAKE_DIRECTORY "${SALTS_UNICODE_DATA_DIR}")
  set(destination "${SALTS_UNICODE_DATA_DIR}/${name}")
  file(LOCK "${destination}.lock" GUARD FUNCTION TIMEOUT 180)
  if(EXISTS "${destination}")
    file(SHA256 "${destination}" actual)
    if(NOT actual STREQUAL sha256)
      message(FATAL_ERROR "Unicode cache hash mismatch: ${destination}. Remove the invalid file and restore it again.")
    endif()
    return()
  endif()
  message(STATUS "Downloading Unicode 17.0.0 ${name}")
  file(DOWNLOAD "${url}" "${destination}.download"
    TLS_VERIFY ON
    TIMEOUT 180 INACTIVITY_TIMEOUT 30 STATUS status)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    file(REMOVE "${destination}.download")
    message(FATAL_ERROR "Unicode download failed: ${url}: ${status}")
  endif()
  file(SHA256 "${destination}.download" actual)
  if(NOT actual STREQUAL sha256)
    file(REMOVE "${destination}.download")
    message(FATAL_ERROR "Unicode download hash mismatch: ${url}; expected ${sha256}, got ${actual}")
  endif()
  file(RENAME "${destination}.download" "${destination}")
endfunction()

# Developer entry point: restore every generator input with cmake -P.
if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  file(READ "${CMAKE_CURRENT_LIST_DIR}/sources.lock.json" manifest)
  string(JSON count LENGTH "${manifest}" files)
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON name MEMBER "${manifest}" files ${index})
    download_unicode_file("${name}")
  endforeach()
endif()
