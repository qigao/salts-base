      }
    },
    "asn1_x509_integration_test": {
      "kind": "executable",
      "sources": {
        "files": [
          "test_x509_integration.c"
        ]
      },
      "private": {
        "deps": [
          "asn1",
          "tinytest"
        ]
      },
      "test": {
        "name": "asn1.x509_integration",
        "environment": [
          "TZ=EST5"
        ]
      }
    },
    "asn1_mib_compiler_test": {
      "kind": "executable",
      "sources": {
        "files": [
          "test_mib_compiler.c"
        ]
      },
      "private": {
        "deps": [
          "asn1",
          "tinytest"
        ],
        "includeDirs": [
          "../src"
        ]
      },
      "test": {
        "name": "asn1.mib_compiler"
      }
    },
    "asn1_header_cpp17": {
      "kind": "executable",
      "sources": {
        "files": [
          "header_cpp.cpp"
        ]
      },
      "private": {
        "deps": [
          "asn1",
          "tinytest"
        ]
      },
      "test": {
        "name": "asn1.header_cpp17"
      }
    },
    "asn1_mib_generated_test": {
      "kind": "executable",
      "when": {
        "native": true
      },
      "sources": {
        "files": [
          "test_mib_generated.c",
          "$builddir/gen/asn1-mib/Basic-MIB.c",
          "$builddir/gen/asn1-mib/Basic-MIB_runtime.c",
          "$builddir/gen/asn1-mib/Empty-MIB.c",
          "$builddir/gen/asn1-mib/Empty-MIB_runtime.c"
        ]
      },
      "private": {
        "deps": [
          "asn1",
          "tinytest"
        ],
        "includeDirs": [
          "$builddir/gen/asn1-mib"
        ]
      },
      "test": {
        "name": "asn1.mib_generated"
      },
      "preTasks": [
        {
          "name": "mib_basic",
          "tool": "mib_compiler",
          "inputs": [
            "basic.mib"
          ],
          "args": [
            "-o",
            "$builddir/gen/asn1-mib",
            "$moduledir/basic.mib"
          ],
          "outputs": [
            "$builddir/gen/asn1-mib/Basic-MIB.h",
            "$builddir/gen/asn1-mib/Basic-MIB.c",
            "$builddir/gen/asn1-mib/Basic-MIB_runtime.c"
          ]
        },
        {
          "name": "mib_empty",
          "tool": "mib_compiler",
          "inputs": [
            "empty.mib"
          ],
          "args": [
            "-o",
            "$builddir/gen/asn1-mib",
            "$moduledir/empty.mib"
          ],
          "outputs": [
            "$builddir/gen/asn1-mib/Empty-MIB.h",
            "$builddir/gen/asn1-mib/Empty-MIB.c",
            "$builddir/gen/asn1-mib/Empty-MIB_runtime.c"
          ]
        }
      ]
    }
  }
}
