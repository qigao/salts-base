@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
# Required by the static Crypto and Media targets in the unified SDK export.
find_dependency(GmSSL CONFIG REQUIRED)
if(WIN32 OR ANDROID OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
  find_dependency(JPEG REQUIRED)
  find_dependency(libyuv CONFIG REQUIRED)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/SaltsCoreTargets.cmake")
check_required_components(SaltsCore)
