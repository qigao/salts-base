@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(WIN32 OR ANDROID OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
  find_dependency(JPEG REQUIRED)
  find_dependency(libyuv CONFIG REQUIRED)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/SaltsBaseTargets.cmake")
check_required_components(SaltsBase)
